{
  "name": "screenguard-cloudflare-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker + R2 + D1 backend for ScreenGuard incidents and guardian approvals",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute screenguard-db --local --file=schema.sql",
    "db:deploy": "wrangler d1 execute screenguard-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.109.2"
  }
}
