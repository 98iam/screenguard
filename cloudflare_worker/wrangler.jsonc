{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenguard-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-02-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "screenguard-screenshots"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "screenguard-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
